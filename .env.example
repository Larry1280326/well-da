# =============================================================================
# Well Da Website — Environment Variables
# =============================================================================
#
# LOCAL DEVELOPMENT:
#   Copy this file to .env.local and fill in your values.
#   .env.local is git-ignored and will NOT be committed.
#
# PRODUCTION (AWS Amplify):
#   Set every variable below in the Amplify Console:
#   App settings → Environment variables
#   Do NOT rely on .env.local files — they are not deployed.
#
# SES (email) variables are optional — RFQ submissions still succeed
# without them; customer confirmation and optional staff notification are skipped.
# =============================================================================

# ---- PostgreSQL (AWS RDS) ----
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# ---- AWS S3 (file uploads) ----
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ---- AWS SES (confirmation emails, optional) ----
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SENDER_EMAIL=

# ---- Internal RFQ alert destination (optional until staff inbox confirmed) ----
# Set to one verified, monitored Well Da staff inbox. No default or personal Gmail fallback.
RFQ_NOTIFICATION_EMAIL=

# ---- Optional Bing Webmaster Tools verification token ----
BING_SITE_VERIFICATION=
# Existing Google verification is retained. No GA4 script is installed by default.
# See SEO_RFQ_DELIVERY.md before configuring consented conversion tracking.
